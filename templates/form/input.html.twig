{#
/**
 * @file
 * Theme override for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see template_preprocess_input()
 */
#}
{# Radios and checkboxes render bare: DS 4.6 paints a text-field frame and
   focus ring on the gov-form-input wrapper, which breaks custom-styled
   controls (e.g. the feedback faces). DS has separate radio/checkbox
   components, the text-input wrapper never styled them. #}
{% if ('' ~ attributes.type) in ['radio', 'checkbox'] %}
  <input{{ attributes }}/>{{ children }}
{% else %}
  {{ include('gov_cz:gov-form-input', {
    gov_form_input_type: attributes.type,
    gov_form_input: '<input'~ attributes ~'/>',
    })
  }}
{% endif %}
